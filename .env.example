# ── Database ──────────────────────────────────────────────────────────────────
# For local docker compose, this is set automatically.
# For production, use a managed PostgreSQL URL.
DATABASE_URL=postgresql+asyncpg://opsagent:opsagent@postgres:5432/opsagent

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Phase 4 - additional model providers (optional now)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Redis (Phase 2) ───────────────────────────────────────────────────────────
# For local docker compose, this is set automatically.
REDIS_URL=redis://redis:6379/0

# ── Slack ─────────────────────────────────────────────────────────────────────
# Create a Slack App at: https://api.slack.com/apps
# Required scopes: chat:write, channels:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=your-channel-id
# Found in your Slack App settings → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
RUNBOOKS_PATH=/app/runbooks
ACTIONS_PATH=/app/actions

# ── Phase 4: MLflow experiment tracking ────────────────────────────────────────
# Leave empty to disable MLflow
MLFLOW_TRACKING_URI=http://mlflow:5001

# ── Phase 5: OpenTelemetry tracing ────────────────────────────────────────────
# Leave empty to disable distributed tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=opsagent-api

# ── Phase 6: JWT auth (leave empty in dev to disable auth) ─────────────────────
JWT_SECRET=

# ── Phase 6: Stripe billing ────────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard → Products
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ENTERPRISE=price_...
